// ============================================================================
// md-e2e DSL Grammar  (Lark — Earley parser)
//
// Parses a single natural-language test step into a typed parse tree.
// Supports double-quoted, single-quoted, and backtick-quoted strings.
// All keywords are case-insensitive.
//
// NOTE: Each terminal uses a SINGLE regex pattern with (?i) at the start.
// Lark wraps multi-pattern terminals in (?:...|...) which breaks (?i) flags.
// ============================================================================

start: step

?step: navigate
     | reload
     | click
     | fill
     | select_option
     | hover
     | press_key
     | upload_file
     | check_box
     | uncheck_box
     | assert_visible
     | assert_hidden
     | assert_url
     | assert_title
     | assert_value
     | assert_variable
     | wait_seconds
     | wait_network
     | store_var

// ── Navigation ──────────────────────────────────────────────────────────────
navigate: NAV_KW QSTR
reload:   RELOAD_KW

// ── Interaction ─────────────────────────────────────────────────────────────
click:        CLICK_KW TARGET_TYPE QSTR
            | CLICK_KW QSTR
fill:         FILL_KW TARGET_TYPE QSTR WITH_KW QSTR
            | FILL_KW QSTR WITH_KW QSTR
select_option: SELECT_KW QSTR FROM_KW QSTR
hover:        HOVER_KW TARGET_TYPE QSTR
            | HOVER_KW QSTR
press_key:    PRESS_KW QSTR
upload_file:  UPLOAD_KW QSTR TO_KW QSTR
check_box:    CHECK_KW TARGET_TYPE QSTR
            | CHECK_KW QSTR
uncheck_box:  UNCHECK_KW TARGET_TYPE QSTR
            | UNCHECK_KW QSTR

// ── Assertions ──────────────────────────────────────────────────────────────
assert_visible: ASSERT_KW TARGET_TYPE QSTR IS_VISIBLE
              | ASSERT_KW QSTR IS_VISIBLE
assert_hidden:  ASSERT_KW TARGET_TYPE QSTR IS_HIDDEN
              | ASSERT_KW QSTR IS_HIDDEN
assert_url:     ASSERT_URL_KW CMP QSTR
assert_title:   ASSERT_TITLE_KW CMP QSTR
assert_value:   ASSERT_KW TARGET_TYPE QSTR VALUE_KW CMP QSTR
              | ASSERT_KW QSTR VALUE_KW CMP QSTR
assert_variable: ASSERT_KW VARIABLE_KW QSTR CMP QSTR

// ── State & Control ─────────────────────────────────────────────────────────
wait_seconds: WAIT_KW NUMBER SECONDS_KW
wait_network: WAIT_NETWORK_KW
store_var:    STORE_FROM_KW TARGET_TYPE QSTR AS_KW QSTR
            | STORE_FROM_KW QSTR AS_KW QSTR

// ═══════════════════════════════════════════════════════════════════════════
// Terminals  (ordered by priority: higher = matched first)
//
// IMPORTANT: Each terminal is a SINGLE regex with (?i) at the outermost
// level. Alternations go INSIDE the regex, not across multiple / / patterns.
// ═══════════════════════════════════════════════════════════════════════════

// Multi-word keyword phrases — highest priority so the lexer does not split
// them into individual single-keyword tokens.
NAV_KW.5:           /(?i)(?:navigate\s+to|go\s+to)/
RELOAD_KW.5:        /(?i)reload(?:\s+page)?/
HOVER_KW.5:         /(?i)hover(?:\s+over)?/
ASSERT_URL_KW.5:    /(?i)assert\s+url/
ASSERT_TITLE_KW.5:  /(?i)assert\s+title/
IS_VISIBLE.5:       /(?i)is\s+visible/
IS_HIDDEN.5:        /(?i)is\s+hidden/
WAIT_NETWORK_KW.5:  /(?i)wait\s+for\s+network\s+idle/
STORE_FROM_KW.5:    /(?i)store(?:\s+text)?\s+from/
VARIABLE_KW.5:      /(?i)variable/

// Single-word keywords
CLICK_KW.3:    /(?i)click/
FILL_KW.3:     /(?i)fill/
SELECT_KW.3:   /(?i)select/
PRESS_KW.3:    /(?i)press/
UPLOAD_KW.3:   /(?i)upload/
CHECK_KW.3:    /(?i)check/
UNCHECK_KW.3:  /(?i)uncheck/
ASSERT_KW.3:   /(?i)assert/
WAIT_KW.3:     /(?i)wait/
WITH_KW.3:     /(?i)with/
FROM_KW.3:     /(?i)from/
TO_KW.3:       /(?i)to/
AS_KW.3:       /(?i)as/
VALUE_KW.3:    /(?i)value/
SECONDS_KW.3:  /(?i)seconds?/
CMP.3:         /(?i)(?:matches|contains|equals|equal|is)/

// Element-type hints — lower priority so they lose to keywords above
TARGET_TYPE.2: /(?i)(?:button|link|input|heading|checkbox|radio|text)/

// Quoted strings — double, single, or backtick (single regex with alternation)
QSTR: /(?:\"[^\"\\]*(?:\\.[^\"\\]*)*\"|'[^'\\]*(?:\\.[^'\\]*)*'|`[^`\\]*(?:\\.[^`\\]*)*`)/

NUMBER: /\d+/

%import common.WS
%ignore WS
